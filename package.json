{
  "name": "claude-rules",
  "version": "1.0.0",
  "description": "Sets up the Claude rules and skills on your computer and in each app.",
  "private": true,
  "bin": {
    "claude-rules": "cli/main.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "eslint . --fix",
    "typecheck": "tsc",
    "test": "node cli/test/run-tests.mjs",
    "changelog": "node scripts/changelog.mjs --build",
    "zip": "node scripts/zip.mjs",
    "check": "npm run lint && npm run typecheck && npm test && node scripts/changelog.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^18.19.130",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.4.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3"
  }
}
